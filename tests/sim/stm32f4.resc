:name: stm32-uart-driver
:description: STM32F4 Discovery running the firmware, with the console UART in a terminal window.

$bin?=$ORIGIN/../../build/firmware/stm32-uart-driver.elf

mach create "stm32f4"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl

# Renode clocks SysTick at 72 MHz; the firmware runs on the 16 MHz internal clock.
sysbus.nvic Frequency 16000000

showAnalyzer sysbus.usart2

macro reset
"""
    sysbus LoadELF $bin
"""
runMacro $reset
