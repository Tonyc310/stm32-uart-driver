{
  "version": 6,
  "configurePresets": [
    {
      "name": "firmware",
      "displayName": "Firmware (arm-none-eabi)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/firmware",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "firmware",
      "configurePreset": "firmware"
    }
  ],
  "workflowPresets": [
    {
      "name": "firmware",
      "steps": [
        { "type": "configure", "name": "firmware" },
        { "type": "build", "name": "firmware" }
      ]
    }
  ]
}
