{
  "version": 6,
  "configurePresets": [
    {
      "name": "firmware",
      "displayName": "Firmware (arm-none-eabi)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/firmware",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-tests",
      "displayName": "Unit tests (host, sanitized)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "firmware",
      "configurePreset": "firmware"
    },
    {
      "name": "host-tests",
      "configurePreset": "host-tests"
    }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sim-tests",
      "displayName": "Firmware tests in Renode",
      "configurePreset": "firmware",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "firmware",
      "steps": [
        { "type": "configure", "name": "firmware" },
        { "type": "build", "name": "firmware" }
      ]
    },
    {
      "name": "host-tests",
      "steps": [
        { "type": "configure", "name": "host-tests" },
        { "type": "build", "name": "host-tests" },
        { "type": "test", "name": "host-tests" }
      ]
    },
    {
      "name": "sim-tests",
      "steps": [
        { "type": "configure", "name": "firmware" },
        { "type": "build", "name": "firmware" },
        { "type": "test", "name": "sim-tests" }
      ]
    }
  ]
}
